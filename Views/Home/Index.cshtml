@{
    ViewData["Title"] = "Home Page";
    
}

<div class="page-container">

    <div class="hero-section">
        <div class="hero-icon">
            <i class="bi bi-box-seam"></i>
        </div>
        <h1 class="hero-title">Bienvenido a InventPro</h1>
        <p class="hero-subtitle">
            Gestiona tu inventario de forma simple, rápida y organizada.
            Controla existencias, movimientos y reportes desde un solo lugar.
        </p>
        <div class="hero-actions">
            <a href="#" class="btn-primary">
                <i class="bi bi-speedometer2"></i> Ir al Dashboard
            </a>
            <a href="~/Documentacion/README.md" class="btn-secondary">
                <i class="bi bi-book"></i> Documentación
            </a>
        </div>
    </div>

    <table class="info-table">
        <tr>
            <td>
                <div class="box">
                    <i class="bi bi-boxes box-icon"></i>
                    <h3 class="box-title">Control de Inventario</h3>
                    <p class="box-text">
                        Lleva el registro exacto de tus productos en tiempo real.
                        Visualiza existencias, ubicaciones y movimientos sin complicaciones.
                    </p>
                </div>
            </td>
            <td>
                <div class="box">
                    <i class="bi bi-graph-up-arrow box-icon"></i>
                    <h3 class="box-title">Reportes Inteligentes</h3>
                    <p class="box-text">
                        Genera informes claros sobre entradas, salidas y rotación de productos.
                    </p>
                </div>
            </td>
        </tr>
    </table>

</div>